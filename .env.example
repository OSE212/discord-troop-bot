# Copy this file to .env and fill in real values. Never commit .env.

# Required: your Discord bot token (from the Discord Developer Portal).
DISCORD_TOKEN=

# Optional: defaults to a local SQLite file (troop_bot.db) if unset.
# Point this at a PostgreSQL URL later without changing any code, e.g.
# postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=

# Optional: names of the Discord server roles that grant admin / calculator
# permissions (spec section 23). Server "Manage Server"/"Administrator"
# permission always counts as admin regardless of this setting.
ADMIN_ROLE_NAME=Troop Admin
CALCULATOR_ROLE_NAME=Troop Calculator

# Optional: where the editable optimizer weight config lives.
# Defaults to config/rules.json.
RULES_CONFIG_PATH=

# Web Admin Panel Configuration
# Host & Port for the Web Dashboard (default: 8080)
WEB_PORT=8080
ENABLE_WEB_PANEL=true

# Master Passkey for Web Panel Admin/Owner login (default: admin123)
ADMIN_PANEL_KEY=admin123

# Optional: Discord OAuth2 Login for automatic Owner/Server Admin detection
# Create credentials in Discord Developer Portal -> OAuth2 -> General
BOT_OWNER_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/discord/callback
